<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView 全屏垫底：半透明工具栏悬浮其上（网页内容透出，浏览器质感） -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 安装/启动进度条：Installing 显示真实解压百分比，Starting 转不确定动画 -->
    <ProgressBar
        android:id="@+id/installProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:layout_gravity="top"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:progressTint="#FF7DD3FC"
        android:progressBackgroundTint="#26FFFFFF"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- 工具栏隐藏后的顶部把手：小圆角胶囊，可拖到屏幕边缘任意位置（避让遮挡），点它唤回工具栏 -->
    <LinearLayout
        android:id="@+id/handleBar"
        android:layout_width="64dp"
        android:layout_height="16dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_handle_bar"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <View
            android:layout_width="28dp"
            android:layout_height="3dp"
            android:background="#99FFFFFF" />
    </LinearLayout>

    <!-- 工具栏：70% 半透明悬浮层；点文字空白区隐藏，点把手唤回 -->
    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#B31A2028"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:textColor="#FF9CA3AF"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 预览模式返回按钮：仅当 WebView 位于非引擎端口的回环页面时显示 -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_back"
            android:textColor="#FF6EE7B7"
            android:textSize="13sp"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_restart"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 日志查看器入口：engine.log / boot.log 尾部（排查引擎重启等问题） -->
        <TextView
            android:id="@+id/btnLog"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_log"
            android:textColor="#FF9AA5B4"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 原生终端入口：跳转独立终端页（真 PTY，自带 bash） -->
        <TextView
            android:id="@+id/btnTerminal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_terminal"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 隐藏工具栏：一键让网页全屏（点顶部小把手唤回） -->
        <TextView
            android:id="@+id/btnHide"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_hide"
            android:textColor="#FF9CA3AF"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- 设置入口：齿轮图标（跳转独立设置页） -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_settings"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <!-- ==================== 启动动画（v1.3.1） ====================
         冷启动时运行时解压 + 引擎启动需要时间，之前这段时间是一块空黑屏（用户反馈）。
         这里用一层品牌遮罩盖住：logo 淡入 + 轻微呼吸、真实解压百分比、
         状态文案随引擎阶段变化；WebView 首屏加载完成后淡出。
         clickable/focusable：遮罩期间吞掉误触，避免用户点到下面还没就绪的界面。 -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF101418"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="#FFF2F5F9"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/splash_preparing"
            android:textColor="#FF9CA3AF"
            android:textSize="13sp" />

        <!-- v1.4.8：已用秒数 + 当前阶段名。之前只有一句「正在启动」，用户无法判断
             是在推进还是卡死（手表上 12s 与 40s 的观感完全一样）。 -->
        <TextView
            android:id="@+id/splashElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF7DD3FC"
            android:textSize="12sp"
            android:fontFamily="monospace"
            tools:text="3.2s" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:progressTint="#FF7DD3FC"
            android:progressBackgroundTint="#26FFFFFF" />

        <!-- v1.4.8：文件加载明细（解压阶段显示 M/N 个文件） -->
        <TextView
            android:id="@+id/splashDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FF6B7684"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            tools:text="48,203 / 50,405 files" />

        <!-- 展开/收起完整阶段列表。遮罩本身吞触摸，点这里不会穿透到底下界面。 -->
        <TextView
            android:id="@+id/splashToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/splash_show_steps"
            android:textColor="#FF5A9FD4"
            android:textSize="11sp"
            android:background="#14FFFFFF" />

        <!-- 阶段列表：默认收起；展开时用 layout_weight 占满剩余空间并可滚动，
             这样阶段很多时也不会把上方的 logo 顶出屏幕。 -->
        <ScrollView
            android:id="@+id/splashStepsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/splashSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:paddingBottom="12dp"
                android:textColor="#FF8A94A3"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp" />
        </ScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/splash_hint"
            android:textColor="#FF5A6472"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
