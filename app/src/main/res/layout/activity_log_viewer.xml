<?xml version="1.0" encoding="utf-8"?>
<!-- 日志查看器：engine.log / boot.log 尾部，自动刷新 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF101418"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:id="@+id/log_viewer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/log_viewer_title"
            android:textColor="#FF9AA5B4"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/log_viewer_share"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/log_viewer_share"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/log_viewer_refresh"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/log_viewer_refresh"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 文件选择：engine.log / boot.log -->
    <LinearLayout
        android:id="@+id/log_viewer_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="6dp" />

    <!-- 文件路径与大小 -->
    <TextView
        android:id="@+id/log_viewer_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FF6B7684"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_terminal"
        android:fillViewport="true">

        <TextView
            android:id="@+id/log_viewer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textColor="#FFC9D4E0"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
